{
  "name": "ruhomo",
  "version": "0.1.0",
  "private": true,
  "description": "Convert an extra Mihomo rules list into per-target HTTP rule-providers and Sub-Store YAML/JS overrides.",
  "license": "MIT",
  "author": "Lumintian",
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* run dev",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r run typecheck",
    "test": "vitest run",
    "test:workerd": "pnpm --filter @ruhomo/worker run test:workerd",
    "test:e2e": "pnpm --filter @ruhomo/web run test:e2e",
    "test:integration": "node scripts/fetch-mihomo.mjs && vitest run --config tests/integration/vitest.config.ts",
    "bench": "node --experimental-strip-types scripts/bench.ts",
    "build": "pnpm --filter @ruhomo/web run build && pnpm --filter @ruhomo/worker run build",
    "deploy": "pnpm run build && pnpm --filter @ruhomo/worker run deploy"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.5.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.5.1",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.9.2",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "4.1.9",
    "yaml": "2.9.1"
  }
}
