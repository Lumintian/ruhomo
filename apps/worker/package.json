{
  "name": "@ruhomo/worker",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node -e \"require('fs').mkdirSync('../web/dist',{recursive:true})\" && wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/workerd/tsconfig.json",
    "test:workerd": "vitest run --config vitest.workerd.config.ts"
  },
  "dependencies": {
    "@ruhomo/core": "workspace:*",
    "hono": "4.13.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260921.1",
    "wrangler": "4.136.1"
  }
}
